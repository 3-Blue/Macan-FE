# Public site URL (used for canonical/OG/sitemap once wired up).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plausible Analytics (optional). Cookieless — loads unconditionally once
# set, no consent-gating needed. Full script URL from your Plausible site's
# "Tagged events" install snippet, e.g.
# https://plausible.io/js/pa-vp_XXXXXXXXXXXXXXXXXXXX.js
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=

# Contact form email delivery (server-side, via Resend).
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# ---------------------------------------------------------------------------
# Payload CMS (only needed once you adopt the CMS — see docs/CMS-PAYLOAD.md).
# Leave CONTENT_SOURCE unset (or "local") to keep using the in-repo content.
# ---------------------------------------------------------------------------
# CONTENT_SOURCE=payload
# DATABASE_URI=postgres://user:password@localhost:5432/macan
# PAYLOAD_SECRET=change-me-to-a-long-random-string

# Optional: absolute path for the contact-submissions SQLite file.
# Defaults to ./macan-fe.db (repo root) if unset. On the production VPS,
# point this OUTSIDE the repo directory so it survives `git clean`/redeploys.
CONTACT_DB_PATH=